# Hugo 构建产物，不需要进仓库
public/
resources/_gen/
.hugo_build.lock

# 飞书 API 凭据，绝对不能提交到仓库
.feishu.env
.feishu.env.*

# 飞书导出的中间产物与转换脚本（本地留着，不进仓库）
_feishu_raw/
_feishu_md/
_feishu_export.py
_feishu_convert.py
_feishu.env

# 编辑器/系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# inbox 是投递口：里面放的是还没处理的飞书导出件。
# 这些属于草稿，不该跟着 publish.cmd 一起进公开仓库。
# 只留 .gitkeep 占住这个空目录。
# （踩过一次：放在 inbox 根目录的 .md 被 git add -A 一起提交上去了）
inbox/*
!inbox/.gitkeep
__pycache__/

# 临时下架的文章素材。
# static/ 下的文件会被 Hugo 无条件复制上线，跟文章是不是 draft 无关，
# 所以比赛没结束时，把相关图片从 static/images/ 挪到这里，
# 就不会出现在 public/ 里，也不会被提交进仓库。
_offline/
